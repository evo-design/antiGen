#!/bin/bash
# The train arm of every quarterly cutoff, as a job array: exactly what
# slurm/run_2021.sbatch does for D = 2021-01-01, once per row of
# slurm/cutoffs.tsv (cutoff, tree, root-sequence -- the GISAID chain of
# data/trees/manifest.tsv, which is the lineage /ncov/global belongs to and so
# the one the 2021-01-01 arm already ran on).
#
# prepare runs inside the job rather than being taken from disk, for the reason
# run_2021.sbatch gives, and because each cutoff's queue is its own.
#
# --post-cutoff is not passed at all, and the examples carry no POST_CUTOFF
# lines. In a train arm the flag was always vacuous -- both the tree and the
# queue stop before D, so every record is before it -- and the question it was
# there to answer, which cutoffs a record falls after, is now asked once on the
# shared test tree instead. See Directive, 2026-10-23 (third).
#
# Two departures from run_2021.sbatch, both for disk and both reversible:
#   * no --out-msa. It is the prepared file in another encoding, ~11 GB at the
#     later cutoffs, and 24 of them would not fit.
#   * the prepared file is deleted once place is done with it. It is 12 GB at
#     the later cutoffs and is regenerated by the prepare call above it.
#
#SBATCH --job-name=antigen-series
#SBATCH --partition=cpu_batch_high_mem
#SBATCH --cpus-per-task=32
#SBATCH --mem=96G
#SBATCH --time=12:00:00
#SBATCH --output=work/series/run_%A_%a.log
#
# --exclude: the nodes whose /media/8TBNVME/scratch is not set up. They are the
# *idle* ones, which is why the scheduler prefers them and why this list is not
# optional -- see NOTES, "It is the idle nodes, and that is schedulable around".
# Drop it once the cluster is fixed; `sinfo -p cpu_batch_high_mem -N` and a look
# at which nodes jobs actually ran on is how the list was arrived at.
#SBATCH --exclude=GPU0F98,GPU115A,GPU1034,GPU104C

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$PWD}"

LIST=${ANTIGEN_LIST:-slurm/cutoffs.tsv}
IDX=${SLURM_ARRAY_TASK_ID:-${1:?need an array index or an argument}}
read -r D TREE_REL ROOT_REL < <(sed -n "$((IDX + 1))p" "$LIST")
[ -n "${D:-}" ] || { echo "no row $IDX in $LIST" >&2; exit 1; }

BIN=${ANTIGEN_BIN:-work/antigen_series}
THREADS=${ANTIGEN_THREADS:-${SLURM_CPUS_PER_TASK:-1}}
SEED=${ANTIGEN_SEED:-1}
TREE=data/trees/$TREE_REL
ROOT=data/trees/$ROOT_REL
FASTA=${ANTIGEN_FASTA:-$HOME/sc2-open-data/spike.fasta}
META=${ANTIGEN_META:-$HOME/sc2-open-data/metadata.tsv}
WORK=work/series
OUTDIR=output/sc2-$D/train
mkdir -p "$WORK" "$OUTDIR"

PREP=$WORK/prepared_$D.tsv

echo "host   : $(hostname)"
echo "job    : ${SLURM_JOB_ID:-none} (array ${SLURM_ARRAY_TASK_ID:-none})"
echo "cutoff : $D"
echo "tree   : $TREE"
echo "root   : $ROOT"
echo "binary : $BIN ($(md5sum "$BIN" | cut -d' ' -f1))"
echo "seed   : $SEED"
echo "threads: $THREADS (the tree written does not depend on this)"
echo "start  : $(date)"
echo

"$BIN" prepare \
    --root-seq "$ROOT" \
    --fasta "$FASTA" \
    --metadata "$META" \
    --date-cutoff "$D" \
    --out "$PREP" \
    --out-clock "$WORK/clock_$D.tsv"

echo
echo "prepared: $(date)"
echo

"$BIN" place \
    --tree "$TREE" \
    --root-seq "$ROOT" \
    --prepared "$PREP" \
    --seed "$SEED" \
    --threads "$THREADS" \
    --out-tree "$WORK/tree_$D.tsv" \
    --out "$WORK/sets_$D.tsv" \
    --out-examples "$WORK/examples_$D.txt" \
    --out-matches "$WORK/matches_$D.tsv" \
    --out-counts "$WORK/counts_$D.tsv"

echo
echo "placed : $(date)"
echo

rm -f "$PREP"

cp "$WORK/examples_$D.txt" "$OUTDIR/examples_${D}_cur.txt"
cp "$WORK/tree_$D.tsv"     "$OUTDIR/tree_${D}_cur.tsv"
cp "$WORK/sets_$D.tsv"     "$OUTDIR/sets_${D}_cur.tsv"
cp "$WORK/counts_$D.tsv"   "$OUTDIR/counts_${D}_cur.tsv"
cp "$WORK/clock_$D.tsv"    "$OUTDIR/clock_${D}_cur.tsv"
echo "copied : $OUTDIR (matches_$D.tsv left in $WORK)"
echo

set +e
python3 -I check_examples.py "$WORK/examples_$D.txt"
echo "checker: exit $?"
set -e

echo
echo "done   : $(date)"
